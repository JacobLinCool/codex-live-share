{
  "name": "codex-live-share-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live Share for Codex: share a folder over WebRTC with humans, agents, plans, and meeting transcripts.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm -r --if-present build && node scripts/build-plugin.mjs",
    "typecheck": "pnpm --filter @codex-live-share/transcribe build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev:signal": "pnpm --filter @codex-live-share/signal dev",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
