#!/bin/sh
# Runs the Live Share CLI on a Node runtime, preferring the one Codex ships,
# so the plugin needs nothing installed beyond Codex itself.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

cache_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}
codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac

for candidate in \
  "${CODEX_LIVE_SHARE_NODE:-}" \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_BROWSER_USE_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "$codex_resources/cua_node/bin/node" \
  "$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$root/dist/cli.js" "$@"
  fi
done

if node_path=$(command -v node 2>/dev/null); then
  exec "$node_path" "$root/dist/cli.js" "$@"
fi

printf '%s\n' 'Live Share could not find a Node runtime. Update Codex, or install Node.js 22 or newer.' >&2
exit 127
