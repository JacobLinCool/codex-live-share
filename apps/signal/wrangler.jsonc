{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-live-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "ACCOUNTS", "class_name": "Account" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] }
  ],
  "ratelimits": [
    { "name": "CONNECT_RATE_LIMITER", "namespace_id": "52001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ICE_RATE_LIMITER", "namespace_id": "52002", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "52003", "simple": { "limit": 10, "period": 60 } },
    { "name": "USER_RATE_LIMITER", "namespace_id": "52004", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "GITHUB_CLIENT_ID": ""
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true }
}
