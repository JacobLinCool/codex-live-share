{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-live-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    { "name": "CONNECT_RATE_LIMITER", "namespace_id": "52001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ICE_RATE_LIMITER", "namespace_id": "52002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
