    "@codex-live-share/transcribe": "workspace:*",
    "@codex-live-share/web": "workspace:*",
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "lib0": "0.2.119",
    "node-datachannel": "0.33.4",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
