#!/bin/sh
# Select a Node runtime that can actually load the bundled WebRTC addon.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

entry="$root/dist/cli.js"
probe_mode=cli
if [ "${1:-}" = hook ]; then
  entry="$root/dist/hook.js"
  probe_mode=hook
  shift
fi

# A signed macOS runtime can execute JavaScript but reject third-party native
# addons. MCP needs the addon; the lightweight hook bridge does not.
if [ -n "${CODEX_LIVE_SHARE_NODE:-}" ]; then
  "$CODEX_LIVE_SHARE_NODE" "$root/bin/check-runtime.mjs" "$probe_mode" >/dev/null
  exec "$CODEX_LIVE_SHARE_NODE" "$entry" "$@"
fi

cache_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}
codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac

for candidate in \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_BROWSER_USE_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "$codex_resources/cua_node/bin/node" \
  "$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" \
  "$(command -v node 2>/dev/null || true)"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ] && \
    "$candidate" "$root/bin/check-runtime.mjs" "$probe_mode" >/dev/null 2>&1; then
    exec "$candidate" "$entry" "$@"
  fi
done

printf '%s\n' 'Live Share needs Node.js 22 or newer that can load its bundled WebRTC addon. None of the discovered runtimes passed the startup check. Install Node.js 22 or newer and set CODEX_LIVE_SHARE_NODE to its executable.' >&2
exit 127
